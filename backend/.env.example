# ── PostgreSQL ──────────────────────────────────────────────────────────────
# LangGraph uses a plain psycopg (sync) connection for the store and checkpointer
LANGGRAPH_DB_URL=postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable

# SQLAlchemy async engine for app tables (users, conversations)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5442/postgres

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ── CORS ────────────────────────────────────────────────────────────────────
# JSON list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── LLM ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Web search ───────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...
