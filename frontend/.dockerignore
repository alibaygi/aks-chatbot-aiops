# Version control
.git/
.gitignore

# Dependencies (rebuilt inside the image)
node_modules/

# Next.js build output (rebuilt inside the image)
.next/
out/

# Environment files (secrets must not enter the image)
.env
.env.*
!.env.local.example

# Test and coverage artefacts
coverage/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript incremental build info
*.tsbuildinfo

# Docs / editor artefacts
README.md
AGENTS.md
CLAUDE.md
.DS_Store
