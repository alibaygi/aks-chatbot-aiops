# Copy this file to values-secrets.yaml and fill in every field.
# values-secrets.yaml is listed in .gitignore and .helmignore — it will
# never be committed to the repository.
#
# In the CI/CD pipeline this file is supplied via the HELM_VALUES_SECRETS
# GitHub Secret (multiline). When deploying manually, pass it with:
#   helm upgrade --install chatbot k8s/aks/chart -f k8s/aks/chart/values-secrets.yaml

secrets:
  postgres:
    password: "<strong-password>"

  backend:
    # Generate with: openssl rand -hex 32
    secretKey: "<jwt-secret-key>"
    openaiApiKey: "<your-openai-api-key>"
    tavilyApiKey: "<your-tavily-api-key>"
    # Get your LangSmith API key from https://smith.langchain.com → Settings
    # Leave empty to disable tracing.
    langsmithApiKey: "<your-langsmith-api-key>"
